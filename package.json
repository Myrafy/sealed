{
  "name": "sealed",
  "version": "1.0.0",
  "description": "Local encrypted secrets manager for developers",
  "main": "./out/main/index.js",
  "author": {
    "name": "Sealed"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "dev": "node scripts/ensure-electron.js && env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "node scripts/ensure-electron.js && electron-builder install-app-deps",
    "electron:install": "node scripts/ensure-electron.js",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "test": "vitest run"
  },
  "dependencies": {
    "mongodb": "^6.9.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^2.0.0",
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.8.0",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.6",
    "vitest": "^2.1.1",
    "zustand": "^5.0.0"
  }
}
